# Database Configuration
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa

# Redis Configuration
REDIS_URL=redis://redis:6379

# Razorpay Configuration (add your keys later)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# BTCPay Configuration (add your keys later)
BTCPAY_SERVER_URL=your_btcpay_server_url
BTCPAY_STORE_ID=your_store_id
BTCPAY_API_KEY=your_api_key
BTCPAY_WEBHOOK_SECRET=your_btcpay_webhook_secret

# Medusa Configuration
JWT_SECRET=something_really_secret
COOKIE_SECRET=something_really_secret

# Storefront Configuration
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
EOF
